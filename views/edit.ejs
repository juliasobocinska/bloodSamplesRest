<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pobieranie Krwii - Zamówienie</title>
</head>
<body>
    <nav>
    <a href="/edit">Edycja zamówień</a>
    <a href="/">Strona Główna</a>
    <a href="/history">Historia zamówień</a>
    <a href="/login" style="margin-right: 15px;">Zaloguj się</a>
    <a href="/register" style="margin-right: 15px;">Zarejestruj się</a>
    <a href="/history">Historia zamówień</a>
    <a href="/logout" style="color: red;">Wyloguj</a>
</nav>

    <h1>Zestaw do samodzielnego pobrania krwii</h1>
    
    <form action="/update/<%= id %>" method="POST">
        <label for="age">Wiek:</label>
        <input type="number" id="age" name="age" min="18" value="<%= order.age %>">

        <label for="quantity_samples">Ilość próbek:</label>
        <input type="number" id="quantity_samples" name="quantity_samples" min="1" max="5" value="<%= order.amount %>">

            <P>Wybierz badania(max 5):</P>
        <input type="checkbox" id="thyroid" name="tests" value="Tarczyca" value="<%= order.test %>">
        <label for="thyroid">Tarczyca (TSH)</label><br>
        <input type="checkbox" id="cholesterol" name="tests" value="Profil lipidowy (Cholesterol)" value="<%= order.test %>">
        <label for="cholesterol">Profil lipidowy (Cholesterol)</label><br>
        <input type="checkbox" id="morphology" name="badania" value="Morfologia" value="<%= order.test %>">
        <label for="morphology">Morfologia pełna</label><br>
        <input type="checkbox" id="glucose" name="tests" value="Glukoza" value="<%= order.test %>">
        <label for="glucose">Glukoza</label><br>
        <input type="checkbox" id="vitamine_D" name="tests" value="Witamina D" value="<%= order.test %>">
        <label for="vitamine_D">Witamina D</label><br>
        <input type="checkbox" id="blood_diseases" name="tests" value="Choroby krwi (skaza krwotoczna)" value="<%= order.test %>">
        <label for="blood_diseases">Choroby krwi (skaza krwotoczna)</label><br>
        <input type="checkbox" id="allergies" name="tests" value="Alergie" value="<%= order.test %>">
        <label for="allergies">Alergie</label><br>
        <input type="checkbox" id="blood_type" name="tests" value="Grupa krwi" value="<%= order.test %>">
        <label for="blood_type">Grupa krwi</label><br>
        <input type="checkbox" id="electrolyte_disorders" name="tests" value="Zaburzenia elektrolitowe (Poziom sodu, potasu, magnezu)" value="<%= order.test %>">
        <label for="electrolyte_disorders">Zaburzenia elektrolitowe (Poziom sodu, potasu, magnezu)</label><br>
        <input type="checkbox" id="anemia" name="tests" value="Anemia" value="<%= order.test %>">
        <label for="anemia">Anemia</label><br>

        <input type="submit" value="Prześlij">
    </form>
</body>
</html>

