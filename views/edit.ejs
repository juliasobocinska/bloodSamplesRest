<%- include('partials/head') %>
<%- include('partials/nav') %>

<h1>Zestaw do samodzielnego pobrania krwi</h1>
    
<form action="/update/<%= order.id %>" method="POST">
    <label for="age">Wiek:</label>
    <input type="number" id="age" name="age" min="18" value="<%= order.age %>"><br><br>

    <label for="quantity_samples">Ilość próbek:</label>
    <input type="number" id="quantity_samples" name="quantity_samples" min="1" max="5" value="<%= order.quantity %>"><br><br>

    <p>Wybierz badania (max 5):</p>
    <input type="checkbox" id="thyroid" name="tests" value="Tarczyca" <%= order.sample_type && order.sample_type.includes('Tarczyca') ? 'checked' : '' %>>
    <label for="thyroid">Tarczyca (TSH)</label><br>
    
    <input type="checkbox" id="cholesterol" name="tests" value="Profil lipidowy (Cholesterol)" <%= order.sample_type && order.sample_type.includes('Profil lipidowy (Cholesterol)') ? 'checked' : '' %>>
    <label for="cholesterol">Profil lipidowy (Cholesterol)</label><br>
    
    <input type="checkbox" id="morphology" name="tests" value="Morfologia" <%= order.sample_type && order.sample_type.includes('Morfologia pełna') ? 'checked' : '' %>>
    <label for="morphology">Morfologia pełna</label><br>
    
    <input type="checkbox" id="glucose" name="tests" value="Glukoza" <%= order.sample_type && order.sample_type.includes('Glukoza') ? 'checked' : '' %>>
    <label for="glucose">Glukoza</label><br>
    
    <input type="checkbox" id="vitamine_D" name="tests" value="Witamina D" <%= order.sample_type && order.sample_type.includes('Witamina D') ? 'checked' : '' %>>
    <label for="vitamine_D">Witamina D</label><br>
    
    <input type="checkbox" id="blood_diseases" name="tests" value="Choroby krwi (skaza krwotoczna)" <%= order.sample_type && order.sample_type.includes('Choroby krwi (skaza krwotoczna)') ? 'checked' : '' %>>
    <label for="blood_diseases">Choroby krwi (skaza krwotoczna)</label><br>
    
    <input type="checkbox" id="allergies" name="tests" value="Alergie" <%= order.sample_type && order.sample_type.includes('Alergie') ? 'checked' : '' %>>
    <label for="allergies">Alergie</label><br>
    
    <input type="checkbox" id="blood_type" name="tests" value="Grupa krwi" <%= order.sample_type && order.sample_type.includes('Grupa krwi') ? 'checked' : '' %>>
    <label for="blood_type">Grupa krwi</label><br>
    
    <input type="checkbox" id="electrolyte_disorders" name="tests" value="Zaburzenia elektrolitowe" <%= order.sample_type && order.sample_type.includes('Zaburzenia elektrolitowe') ? 'checked' : '' %>>
    <label for="electrolyte_disorders">Zaburzenia elektrolitowe</label><br>
    
    <input type="checkbox" id="anemia" name="tests" value="Anemia" <%= order.sample_type && order.sample_type.includes('Anemia') ? 'checked' : '' %>>
    <label for="anemia">Anemia</label><br><br>

    <input type="submit" value="Prześlij">
</form>

<%- include('partials/footer') %>
