<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Historia Zamówień</title>
</head>
<body>
     <nav>
    <a href="/history" style="margin-right: 15px;">Historia zamówień</a>
    <a href="/">Złóż zamówienie</a>
    <a href="/">Strona Główna</a>
    <a href="/logout" style="color: red;">Wyloguj</a>
    <table border="1">
    <thead>
        <tr>
            <th>Wiek</th>
            <th>Ilość próbek</th>
            <th>Badania</th>
            <th>Data</th>
            <th>Akcja</th>
        </tr>
    </thead>
    <tbody>
        <% if (myOrders && myOrders.length > 0) { %>
            <% myOrders.forEach((z, index) => { %> 
                <tr>
                    <td><%= z.age %></td>
                    <td><%= z.quantity %></td>
                    <td><%= Array.isArray(z.tests) ? z.tests.join(', ') : z.tests %></td>
                    <td><%= new Date(z.data).toLocaleDateString() %></td>
                    <td>
                        <a href="/delete/<%= index %>" 
                           onclick="return confirm('Czy na pewno usunąć?')" 
                           style="color: red; text-decoration: none; font-weight: bold;">
                           [ Usuń ]
                        </a>
                        
                        <a href="/edit/<%= index %>" style="color: blue; text-decoration: none; font-weight: bold;">
                           [ Edytuj ]
                        </a>
                    </td>
                </tr>
            <% }); %>
        <% } else { %>
            <tr>
                <td colspan="5">Brak zamówień w systemie.</td>
            </tr>
        <% } %>
    </tbody>
</table>
</body>
</html>