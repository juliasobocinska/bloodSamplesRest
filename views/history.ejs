<%- include('partials/head') %>
<%- include('partials/nav') %>

<h1>Historia Zamówień</h1>

<table class="styled-table">
    <thead>
        <tr>
            <th>Wiek</th>
            <th>Ilość próbek</th>
            <th>Badania</th>
            <th>Data</th>
            <th>Akcja</th>
        </tr>
    </thead>
    <tbody>
        <% if (myOrders && myOrders.length > 0) { %>
            <% myOrders.forEach((z, index) => { %> 
                <tr>
                    <td><%= z.age %></td>
                    <td><%= z.amount || z.quantity %></td>
                    <td><%= Array.isArray(z.tests) ? z.tests.join(', ') : z.tests %></td>
                    <td><%= new Date(z.date || z.data).toLocaleDateString() %></td>
                    <td>
                        <a href="/delete/<%= z.id %>" onclick="return confirm('Czy na pewno?')">[ Usuń ]</a>
                        <a href="/edit/<%= z.id %>">[ Edytuj ]</a>
                    </td>
                </tr>
            <% }); %>
        <% } else { %>
            <tr>
                <td colspan="5">Brak zamówień w systemie.</td>
            </tr>
        <% } %>
    </tbody>
</table>

<%- include('partials/footer') %>
