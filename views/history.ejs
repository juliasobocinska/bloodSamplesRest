<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Historia Zamówień</title>
</head>
<body> <table border="1">
    <thead>
        <tr>
            <th>Wiek</th>
            <th>Ilość próbek</th>
            <th>Badania</th>
            <th>Data</th>
            <th>Akcja</th>
        </tr>
    </thead>
    <tbody>
        <% if (myOrder && myOrder.length > 0) { %>
            <% # Dodajemy 'index' do nawiasu, żeby móc go użyć w linkach %>
            <% myOrder.forEach((z, index) => { %> 
                <tr>
                    <td><%= z.wiek %></td>
                    <td><%= z.ilosc %></td>
                    <td><%= Array.isArray(z.badanie) ? z.badanie.join(', ') : z.badanie %></td>
                    <td><%= new Date(z.data).toLocaleDateString() %></td>
                    <td>
                        <a href="/delete/<%= index %>" 
                           onclick="return confirm('Czy na pewno usunąć?')" 
                           style="color: red; text-decoration: none; font-weight: bold;">
                           [ Usuń ]
                        </a>
                        
                        <a href="/edit/<%= index %>" style="color: blue; text-decoration: none; font-weight: bold;">
                           [ Edytuj ]
                        </a>
                    </td>
                </tr>
            <% }); %>
        <% } else { %>
            <tr>
                <td colspan="5">Brak zamówień w systemie.</td>
            </tr>
        <% } %>
    </tbody>
</table>
<br>
<a href="/">Dodaj nowe zamówienie</a>
</body>
</html>