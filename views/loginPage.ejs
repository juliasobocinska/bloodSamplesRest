<%- include('partials/head') %>
<%- include('partials/nav') %>

<div class="login-box">
    <h2>Zaloguj się</h2>
    <form action="/login" method="post">
        <% if (err) { %> <p class="error"><%= err %></p> <% } %>
        <label for="username">Login:</label><br>
        <input type="text" id="username" name="username" required placeholder="Wpisz login"><br><br>

        <label for="password">Hasło:</label><br>
        <input type="password" id="password" name="password" required placeholder="Wpisz hasło"><br><br>

        <button type="submit" class="btn-submit">Zaloguj się</button>
    </form>
</div>

<%- include('partials/footer') %>
