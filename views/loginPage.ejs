<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Logowanie - System Krwiodawstwa</title>
    <style></style>
</head>
<body>
    <div class="login-box">
        <h2>Zaloguj się</h2>
        <form action="/login" method="post">
            <label>Login:</label>
            <input type="text" name="username" required placeholder="Wpisz login">

            <label>Hasło:</label>
            <input type="password" name="password" required placeholder="Wpisz hasło">

            <button type="submit">Zaloguj się</button>
        </form>
    </div>
</body>
</html>