<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Logowanie - System Krwiodawstwa</title>
    <style></style>
</head>
<body>
    <nav>
    <a href="/login">Zaloguj się</a>
    <a href="/" style="margin-right: 15px;">Strona Główna</a>
    <a href="/register" style="margin-right: 15px;">Zarejestruj się</a>
</nav>
    <div class="login-box">
        <h2>Zaloguj się</h2>
        <form action="/login" method="post">
            <label>Login:</label>
            <input type="text" name="username" required placeholder="Wpisz login">

            <label>Hasło:</label>
            <input type="password" name="password" required placeholder="Wpisz hasło">

            <button type="submit">Zaloguj się</button>
        </form>
    </div>
</body>
</html>