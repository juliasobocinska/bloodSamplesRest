<%- include('partials/head') %>
<%- include('partials/nav') %>

<div class="container">
    <h1>Moje Wyniki Badań Laboratoryjnych</h1>

    <% if (results && results.length > 0) { %>
        <table class="styled-table">
            <thead>
                <tr>
                    <th>Data wprowadzenia</th>
                    <th>Nazwa badania</th>
                    <th>Wartość wyniku</th>
                    <th>Interpretacja / Opis medyczny</th>
                </tr>
            </thead>
            <tbody>
                <% results.forEach(function(r) { %>
                    <tr>
                        <td><%= new Date(r.uploaded_at).toLocaleString('pl-PL') %></td>
                        <td><%= r.test_name %></td>
                        <td><%= r.test_value %></td>
                        
                        <% 
                            // Przypisujemy klasy CSS, które zaraz dopiszemy do pliku style.css
                            let statusClass = (r.description && r.description.includes('Negatywny')) ? 'status-negative' : 'status-positive'; 
                        %>
                        <td class="<%= statusClass %>" style="font-weight: bold;">
                            <%= r.description %>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    <% } else { %>
        <div class="message-box text-center">
            <p>Nie masz jeszcze żadnych dostępnych wyników. Twoje próbki mogą być w trakcie analizy.</p>
        </div>
    <% } %>
</div>

<%- include('partials/footer') %>
