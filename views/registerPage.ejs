<%- include('partials/head') %>
<%- include('partials/nav') %>

<div class="login-box">
    <h2>Załóż nowe konto</h2>
    <form action="/register" method="POST">
        <label for="reg-username">Login:</label><br>
        <input type="text" id="reg-username" name="username" required placeholder="Wpisz proponowany login"><br><br>

        <label for="reg-password">Hasło:</label><br>
        <input type="password" id="reg-password" name="password" required placeholder="Wpisz bezpieczne hasło"><br><br>

        <button type="submit" class="btn-submit">Zarejestruj się</button>
    </form>
</div>

<%- include('partials/footer') %>
